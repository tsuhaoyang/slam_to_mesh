-from torchmcubes import marching_cubes
+
+# torchmcubes does not build against very new PyTorch nightlies / CUDA 13, and
+# TripoSR only needs marching cubes for the final iso-surface extraction (the
+# heavy neural inference stays on the GPU). We use scikit-image's CPU marching
+# cubes as a dependency-light, build-free replacement. It costs a few extra
+# seconds but produces the same surface.
+from skimage import measure
+
+
+def _skimage_marching_cubes(volume: torch.Tensor, threshold: float):
+    """Drop-in for torchmcubes.marching_cubes.
+
+    Args:
+        volume: (R, R, R) float tensor of the (already sign-flipped) field.
+        threshold: iso level.
+    Returns:
+        (verts, faces) as float / long tensors, matching torchmcubes' output
+        conventions (verts in index space, x/y/z order).
+    """
+    vol = volume.detach().cpu().numpy().astype(np.float32)
+    try:
+        verts, faces, _normals, _values = measure.marching_cubes(vol, level=threshold)
+    except (ValueError, RuntimeError):
+        # No surface crossed the iso level → empty mesh.
+        return (
+            torch.zeros((0, 3), dtype=torch.float32),
+            torch.zeros((0, 3), dtype=torch.long),
+        )
+    # skimage returns verts in (i, j, k) == array-index order, which matches the
+    # (x, y, z) indexing torchmcubes returns before TripoSR's [2,1,0] swap.
+    v = torch.from_numpy(np.ascontiguousarray(verts)).float()
+    f = torch.from_numpy(np.ascontiguousarray(faces)).long()
+    return v, f
 
 
